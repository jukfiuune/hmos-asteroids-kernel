# HarmonyOS userspace: binder access tokens and sender info (OpenHarmony kernel features).
CONFIG_ACCESS_TOKENID=y
CONFIG_BINDER_SENDER_INFO=y
# App sandboxes: appspawn puts each app (and ArkWeb renderer) in its own PID namespace (CLONE_NEWPID).
CONFIG_PID_NS=y
# Huawei's Android container (anco, DroiTong): isulad/lxc start it with its own IPC namespace (CLONE_NEWIPC) and mount
# mqueue at its /dev/mqueue. IPC_NS needs SYSVIPC or POSIX_MQUEUE; mqueue covers both, SysV IPC stays off.
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
# ... and its 80 device rules go to a v1 devices cgroup, which iSulad.cfg mounts at /sys/fs/cgroup/devices.
CONFIG_CGROUP_DEVICE=y
